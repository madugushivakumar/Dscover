NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/coy_discover
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/coy_discover?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/coy_discover

# Demo User Identity (Fixed single-user demo identity)
DEMO_USER_ID=demo-user

# Seed configuration
SEED_PROFILE_COUNT=35
